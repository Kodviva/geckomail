{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "unicorn/require-post-message-target-origin": "off",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "typescript/no-explicit-any": "error",
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-debugger": "error",
    "no-console": "off",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "out/**",
    "dist/**",
    "node_modules/**",
    "build/**"
  ]
}
