# geckomail-relay imajı (amd64 + arm64). Dockerfile.server deseni: çok aşamalı, taban imajlar digest ile sabit, yalnız better-sqlite3.

# 1) Paket: Vite SSR ile out/relay/index.mjs (devDependencies gerekir; Electron ikilisi inmez)
FROM node:22-bookworm@sha256:18a6d90fd60542269850c80ca03b29b1d9b14d6b221ac7ee8e35b0d33ef904bd AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY vite.relay.config.ts tsconfig.json ./
COPY src ./src
RUN npm run build:relay

# 2) Çalışma bağımlılığı: yalnız better-sqlite3, sürüm kilit dosyasından
FROM node:22-bookworm@sha256:18a6d90fd60542269850c80ca03b29b1d9b14d6b221ac7ee8e35b0d33ef904bd AS deps
WORKDIR /deps
COPY package-lock.json /tmp/package-lock.json
RUN node -e "\
const l = require('/tmp/package-lock.json').packages;\
const dependencies = { 'better-sqlite3': l['node_modules/better-sqlite3'].version };\
require('fs').writeFileSync('package.json', JSON.stringify({ name: 'geckomail-relay-runtime', private: true, dependencies }));\
" \
 && npm install --omit=dev --no-audit --no-fund \
 && node -e "new (require('better-sqlite3'))(':memory:').prepare('select 1').get()" \
 && rm -rf node_modules/better-sqlite3/deps node_modules/better-sqlite3/src node_modules/better-sqlite3/build \
 && find node_modules/better-sqlite3/prebuilds -type f ! -name "linux-$(node -p process.arch).node" -delete

# 3) Çalışma imajı: yazılabilir tek yer /data, read_only uyumlu
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ENV NODE_ENV=production \
    RELAY_DATA_DIR=/data \
    RELAY_LISTEN=0.0.0.0:8090
RUN groupadd --gid 10001 gecko \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin gecko \
 && mkdir /data && chown 10001:10001 /data
WORKDIR /app
COPY --from=deps /deps/node_modules ./node_modules
COPY --from=build /src/out/relay ./relay
USER 10001:10001
VOLUME /data
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "const l=process.env.RELAY_LISTEN||'0.0.0.0:8090',i=l.lastIndexOf(':');let h=l.slice(0,i);if(h[0]=='[')h=h.slice(1,-1);if(!h||h=='0.0.0.0'||h=='::')h='127.0.0.1';if(h.includes(':'))h='['+h+']';fetch('http://'+h+':'+l.slice(i+1)+'/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["node", "/app/relay/index.mjs"]
