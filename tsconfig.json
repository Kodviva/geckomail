{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "e2e", "electron.vite.config.ts", "vite.server.config.ts", "vite.relay.config.ts", "vite.e2e.config.ts", "vite.web.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
